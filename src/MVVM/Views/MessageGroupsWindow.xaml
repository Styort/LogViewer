<Window x:Class="LogViewer.MVVM.Views.MessageGroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:LogViewer.Localization"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{localization:LocBinding MessageGroups}" Height="640" Width="1100">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="SingleLineMessageTemplate">
                <TextBlock Text="{Binding DisplayText}"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SummaryText}" FontSize="14" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton GroupName="GroupsSource" Margin="0,0,12,0"
                             Content="{localization:LocBinding StatisticsUseFilteredList}"
                             IsChecked="{Binding UseFilteredList, Mode=TwoWay}"/>
                <RadioButton GroupName="GroupsSource"
                             Content="{localization:LocBinding StatisticsUseAllLogs}"
                             IsChecked="{Binding UseAllLogs, Mode=TwoWay}"/>
            </StackPanel>
        </Grid>

        <TextBox Grid.Row="1" Margin="0,0,0,8" Height="28" VerticalContentAlignment="Center"
                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                 materialDesign:HintAssist.Hint="{localization:LocBinding MessageGroupsFilter}"/>

        <Grid Grid.Row="2">
            <ListView x:Name="GroupsListView" ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      GridViewColumnHeader.Click="GridViewColumnHeaderClickedHandler">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{localization:LocBinding StatisticsTotal}" Width="90"
                                        DisplayMemberBinding="{Binding Count}"
                                        HeaderContainerStyle="{StaticResource SearchGridViewColumnHeaderStyle}"/>
                        <GridViewColumn Header="{localization:LocBinding Level}" Width="70"
                                        DisplayMemberBinding="{Binding Level}"
                                        HeaderContainerStyle="{StaticResource SearchGridViewColumnHeaderStyle}"/>
                        <GridViewColumn Header="{localization:LocBinding Logger}" Width="200"
                                        DisplayMemberBinding="{Binding Logger}"
                                        HeaderContainerStyle="{StaticResource SearchGridViewColumnHeaderStyle}"/>
                        <GridViewColumn Header="{localization:LocBinding MessageGroupsHeadline}" Width="360"
                                        CellTemplate="{StaticResource SingleLineMessageTemplate}"
                                        HeaderContainerStyle="{StaticResource SearchGridViewColumnHeaderStyle}"/>
                        <GridViewColumn Header="{localization:LocBinding MessageGroupsFirstTime}" Width="160"
                                        DisplayMemberBinding="{Binding FirstTime, StringFormat={}{0:dd/MM/yyyy HH:mm:ss.fff}}"
                                        HeaderContainerStyle="{StaticResource SearchGridViewColumnHeaderStyle}"/>
                        <GridViewColumn Header="{localization:LocBinding MessageGroupsLastTime}" Width="160"
                                        DisplayMemberBinding="{Binding LastTime, StringFormat={}{0:dd/MM/yyyy HH:mm:ss.fff}}"
                                        HeaderContainerStyle="{StaticResource SearchGridViewColumnHeaderStyle}"/>
                    </GridView>
                </ListView.View>
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="ToolTip" Value="{Binding SampleMessage}"/>
                        <Setter Property="Height" Value="28"/>
                        <EventSetter Event="MouseDoubleClick" Handler="ListViewItem_MouseDoubleClick"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <TextBlock Text="{localization:LocBinding MessageGroupsEmpty}" FontSize="16" Foreground="Gray"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding ShowEmptyPlaceholder, Converter={StaticResource BooleanToVisibility}}"/>

            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Height="50" Width="50"
                         IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding ShowProgress, Converter={StaticResource BooleanToVisibility}}"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button MinWidth="140" Height="30" Margin="0,0,10,0"
                    Content="{localization:LocBinding MessageGroupsShowFirst}"
                    Command="{Binding ShowFirstCommand}"/>
            <Button MinWidth="140" Height="30" Margin="0,0,10,0"
                    Content="{localization:LocBinding MessageGroupsShowLast}"
                    Command="{Binding ShowLastCommand}"/>
            <Button MinWidth="120" Height="30"
                    Content="{localization:LocBinding StatisticsRefresh}"
                    Command="{Binding RefreshCommand}"/>
        </StackPanel>
    </Grid>
</Window>
