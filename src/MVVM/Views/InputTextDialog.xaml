<Window x:Class="LogViewer.MVVM.Views.InputTextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:LogViewer.Localization"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        ShowInTaskbar="False"
        Width="480">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Margin="0,0,0,8"/>
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Background="White" CornerRadius="2"
                SnapsToDevicePixels="True" UseLayoutRounding="True">
            <TextBox x:Name="ValueTextBox" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                     AcceptsReturn="False" VerticalContentAlignment="Center" Padding="8,0" MinHeight="36"/>
        </Border>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Click="OkButtonClick" IsDefault="True" MinWidth="100" Height="30" Margin="0,0,10,0" Content="OK"/>
            <Button IsCancel="True" MinWidth="100" Height="30" Content="{localization:LocBinding Cancel}"/>
        </WrapPanel>
    </Grid>
</Window>
