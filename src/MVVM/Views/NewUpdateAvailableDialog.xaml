<Window x:Class="LogViewer.MVVM.Views.NewUpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:LogViewer.Localization"
        Title="{localization:LocBinding UpdateAvailable}"
        ResizeMode="NoResize"
        SizeToContent="Height"
        ShowInTaskbar="False"
        Width="560">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{localization:LocBinding NewVersionOfLogViewerAvailable}" FontSize="18" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{localization:LocBinding CurrentVersion}" Margin="0,0,12,4"/>
            <TextBlock x:Name="CurrentVersionText" Grid.Column="1" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Text="{localization:LocBinding NewVersion}" Margin="0,0,12,0"/>
            <TextBlock x:Name="NewVersionText" Grid.Row="1" Grid.Column="1" FontWeight="Bold"/>
        </Grid>

        <TextBlock x:Name="ChangelogBlock" Grid.Row="2" Margin="0,0,0,12">
            <Hyperlink x:Name="ChangelogLink" Click="ChangelogLinkClick">
                <!-- Run.Text binds TwoWay by default, and the translation indexer is read-only. -->
                <Run Text="{localization:LocBinding WhatsNew, Mode=OneWay}"/>
            </Hyperlink>
        </TextBlock>

        <Border Grid.Row="3" BorderBrush="{DynamicResource PrimaryHueMidBrush}" BorderThickness="2,0,0,0" Padding="10,4" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{localization:LocBinding UpdateCloseWarning}" TextWrapping="Wrap"/>
                <Button x:Name="SaveSessionButton" HorizontalAlignment="Left" Margin="0,8,0,0" Height="30" MinWidth="160"
                        Content="{localization:LocBinding SaveSessionEllipsis}"/>
            </StackPanel>
        </Border>

        <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Click="UpdateClick" IsDefault="True" MinWidth="110" Height="30" Margin="0,0,10,0" Content="{localization:LocBinding Update}"/>
            <Button Click="RemindLaterClick" MinWidth="110" Height="30" Margin="0,0,10,0" Content="{localization:LocBinding RemindLater}"/>
            <Button Click="SkipClick" MinWidth="110" Height="30" Content="{localization:LocBinding SkipThisVersion}"/>
        </WrapPanel>
    </Grid>
</Window>
