<Window x:Class="LogViewer.MVVM.Views.FilterPresetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:LogViewer.Localization"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{localization:LocBinding FilterPresets}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Height="540" Width="560">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Width="28" Height="28" Padding="0" Margin="8,0,0,0"
                    Style="{StaticResource CircleImageButtonStyle}"
                    Command="{Binding HelpCommand}"
                    Cursor="Hand"
                    ToolTip="{localization:LocBinding FilterPresetsHelpToolTip}">
                <Image Source="{StaticResource InfoImage}" Width="20" Height="20"/>
            </Button>
            <TextBlock Text="{localization:LocBinding FilterPresetsHint}" TextWrapping="Wrap"
                       VerticalAlignment="Center" FontSize="13"/>
        </DockPanel>

        <ListBox Grid.Row="1" x:Name="PresetsList" ItemsSource="{Binding Items}" DisplayMemberPath="Name"
                 SelectedItem="{Binding Selected}"
                 BorderBrush="Gray" BorderThickness="1" Background="White"
                 MouseDoubleClick="PresetsList_OnMouseDoubleClick"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
            <Button MinWidth="100" Height="30" Margin="0,0,8,0" Content="{localization:LocBinding FilterPresetApply}"
                    Command="{Binding ApplyCommand}" IsDefault="True"/>
            <Button MinWidth="100" Height="30" Margin="0,0,8,0" Content="{localization:LocBinding FilterPresetRename}"
                    Command="{Binding RenameCommand}"/>
            <Button MinWidth="100" Height="30" Content="{localization:LocBinding FilterPresetDelete}"
                    Command="{Binding DeleteCommand}"/>
        </StackPanel>

        <GroupBox Grid.Row="3" Margin="0,16,0,0" Header="{localization:LocBinding FilterPresetSaveAs}" Padding="8">
            <StackPanel>
                <TextBlock Text="{localization:LocBinding FilterPresetName}" Margin="0,0,0,6"/>
                <Border BorderBrush="Gray" BorderThickness="1" Background="White" CornerRadius="2" Margin="0,0,0,10">
                    <TextBox Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"
                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                             VerticalContentAlignment="Center" Padding="8,0" MinHeight="32"/>
                </Border>
                <RadioButton GroupName="FilterPresetTime" Content="{localization:LocBinding FilterPresetTimeAbsolute}"
                             IsChecked="{Binding SaveAbsoluteTime}" Margin="0,0,0,4"/>
                <RadioButton GroupName="FilterPresetTime" Content="{localization:LocBinding FilterPresetTimeLeaveUnchanged}"
                             IsChecked="{Binding LeaveTimeIntervalUnchanged}" Margin="0,0,0,4"/>
                <RadioButton GroupName="FilterPresetTime" Content="{localization:LocBinding FilterPresetTimeRelative}"
                             IsChecked="{Binding IsRelativeTimeInterval}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="24,0,0,10">
                    <TextBlock Text="{localization:LocBinding FilterPresetRelativeMinutes}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Width="60" Height="28" Text="{Binding RelativeMinutesText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" MinWidth="160" Height="30"
                        Content="{localization:LocBinding FilterPresetSaveAs}"
                        Command="{Binding SaveCurrentCommand}"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
