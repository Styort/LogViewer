<Window x:Class="LogViewer.MVVM.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogViewer.MVVM"
        xmlns:viewModels="clr-namespace:LogViewer.MVVM.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:validations="clr-namespace:LogViewer.Validations"
        xmlns:dropDownCustomColorPicker="clr-namespace:DropDownCustomColorPicker;assembly=CustomColorPicker"
        xmlns:localization="clr-namespace:LogViewer.Localization"
        mc:Ignorable="d"
        Title="{localization:LocBinding Settings}" Height="830" Width="760" MinWidth="720" MinHeight="700">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="ToolTip" Value="{x:Null}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Window.DataContext>
        <viewModels:SettingsViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <TabControl BorderThickness="0">
            <TabItem Header="{localization:LocBinding General}" Height="25" Width="90">
                <GroupBox FontSize="16" Style="{DynamicResource MaterialDesignGroupBox}" materialDesign:ShadowAssist.ShadowDepth="Depth2">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{localization:LocBinding GeneralSettings}" FontSize="16" Foreground="{Binding DataContext.FontColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{localization:LocBinding AutoStartReadingLogsAtStartup}" ToolTip="{localization:LocBinding AutoStartReadingLogsAtStartupToolTip}" VerticalAlignment="Center" />
                        <ToggleButton Grid.Row="0" Grid.Column="1" IsChecked="{Binding Path=IsAutoStartReadAtStartup}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,0"/>

                        <TextBlock Text="{localization:LocBinding MinimizeToTrayIcon}" ToolTip="{localization:LocBinding MinimizeToTrayIconToolTip}" VerticalAlignment="Center"  Grid.Row="1"/>
                        <ToggleButton Grid.Row="1" Grid.Column="1" IsChecked="{Binding Path=MinimizeToTray}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,0"/>

                        <TextBlock Text="{localization:LocBinding AlertAutoPauseOnError}" ToolTip="{localization:LocBinding AlertAutoPauseOnErrorToolTip}" VerticalAlignment="Center"  Grid.Row="2"/>
                        <ToggleButton Grid.Row="2" Grid.Column="1" IsChecked="{Binding Path=AlertAutoPauseOnError}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,0"/>

                        <TextBlock Text="{localization:LocBinding AlertSoundOnError}" ToolTip="{localization:LocBinding AlertSoundOnErrorToolTip}" VerticalAlignment="Center"  Grid.Row="3"/>
                        <ToggleButton Grid.Row="3" Grid.Column="1" IsChecked="{Binding Path=AlertSoundOnError}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,0"/>

                        <TextBlock Text="{localization:LocBinding AlertBalloonOnError}" ToolTip="{localization:LocBinding AlertBalloonOnErrorToolTip}" VerticalAlignment="Center"  Grid.Row="4"/>
                        <ToggleButton Grid.Row="4" Grid.Column="1" IsChecked="{Binding Path=AlertBalloonOnError}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,0"/>

                        <TextBlock Text="{localization:LocBinding OnlyOneInstanceOfApp}" ToolTip="{localization:LocBinding OnlyOneInstanceOfAppToolTip}" VerticalAlignment="Center"  Grid.Row="5"/>
                        <ToggleButton Grid.Row="5" Grid.Column="1" IsChecked="{Binding Path=OnlyOneAppInstance}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,0"/>

                        <TextBlock Text="{localization:LocBinding ShowSourceColumn}" ToolTip="{localization:LocBinding ShowSourceColumnToolTip}" VerticalAlignment="Center"  Grid.Row="6"/>
                        <ToggleButton Grid.Row="6" Grid.Column="1" IsChecked="{Binding Path=IsShowSourceColumn}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,0"/>

                        <TextBlock Text="{localization:LocBinding ShowThreadColumn}" ToolTip="{localization:LocBinding ShowThreadColumnToolTip}" VerticalAlignment="Center"  Grid.Row="7"/>
                        <ToggleButton Grid.Row="7" Grid.Column="1" IsChecked="{Binding Path=IsShowThreadColumn}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,0"/>

                        <TextBlock Text="{localization:LocBinding ShowErrorTimeline}" ToolTip="{localization:LocBinding ShowErrorTimelineToolTip}" VerticalAlignment="Center"  Grid.Row="8"/>
                        <ToggleButton Grid.Row="8" Grid.Column="1" IsChecked="{Binding Path=IsShowErrorTimeline}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,0"/>

                        <TextBlock Text="{localization:LocBinding ShowProgressOnTaskbarIcon}" ToolTip="{localization:LocBinding ShowProgressOnTaskbarIconToolTip}" VerticalAlignment="Center"  Grid.Row="9"/>
                        <ToggleButton Grid.Row="9" Grid.Column="1" IsChecked="{Binding Path=IsShowTaskbarProgress}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,0"/>

                        <TextBlock Grid.Row="10" Text="{localization:LocBinding MaxMessageBufferSize}" VerticalAlignment="Center" ToolTip="{localization:LocBinding MaxMessageBufferSizeToolTip}"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="10" Grid.Column="1">
                            <ToggleButton IsChecked="{Binding Path=IsEnableMaxMessageBufferSize}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                            <TextBox Width="100" Margin="10,0,10,0" HorizontalContentAlignment="Left" Text="{Binding Path=MaxMessageBufferSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Path=IsEnableMaxMessageBufferSize}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="11" Text="{localization:LocBinding CountOfDeletedMessages}" VerticalAlignment="Center" ToolTip="{localization:LocBinding CountOfDeletedMessagesToolTip}" IsEnabled="{Binding Path=IsEnableMaxMessageBufferSize}"/>
                        <TextBox Grid.Row="11" Grid.Column="1" Width="100"  HorizontalAlignment="Left" HorizontalContentAlignment="Left" Text="{Binding Path=DeletedMessagesCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Path=IsEnableMaxMessageBufferSize}"/>

                        <TextBlock Grid.Row="12" Text="{localization:LocBinding Launguage}" ToolTip="{localization:LocBinding LaunguageToolTip}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="12" Grid.Column="1" ItemsSource="{Binding Path=Languages}" SelectedValue="{Binding Path=SelectedLanguage}" Width="210" HorizontalAlignment="Left" SelectedValuePath="Key" DisplayMemberPath="Value"/>

                        <TextBlock Grid.Row="13" Text="{localization:LocBinding DisplayedDataFormat}" ToolTip="{localization:LocBinding DisplayedDataFormatToolTip}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="13" Grid.Column="1" ItemsSource="{Binding Path=DataFormats}" SelectedItem="{Binding Path=SelectedDataFormat}" Width="210" HorizontalAlignment="Left" ToolTip="{Binding Path=ExampleDateTime}"/>

                        <TextBlock Grid.Row="14" Text="{localization:LocBinding Theme}" ToolTip="{localization:LocBinding ApplicationTheme}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="14" Grid.Column="1" ItemsSource="{Binding Path=Themes}" SelectedItem="{Binding Path=SelectedTheme}" Width="210" HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Background="{Binding Color}" Height="25" Foreground="White" Padding="10,0,10,0" Margin="0,-5"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="15" Text="{localization:LocBinding ThemeFontColor}" ToolTip="{localization:LocBinding ThemeFontColorToolTip}" VerticalAlignment="Center" Margin="0,10"/>
                        <StackPanel Orientation="Horizontal" Grid.Row="15" Grid.Column="1">
                            <dropDownCustomColorPicker:CustomColorPicker Width="50" Margin="0,5,0,0" VerticalAlignment="Center" SelectedColor="{Binding Path=SelectedFontColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource SetDefaultButtonStyle}" Command="{Binding Path=SetDefaultColorCommand}" CommandParameter="Font"/>
                        </StackPanel>

                        <TextBlock Grid.Row="16" Text="{localization:LocBinding MessageFont}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="16" Grid.Column="1" ItemsSource="{Binding Path=MessageFontFamilies}" SelectedItem="{Binding Path=SelectedMessageFontFamily}" Width="210" HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="17" Text="{localization:LocBinding MessageFontSize}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="17" Grid.Column="1" ItemsSource="{Binding Path=MessageFontSizes}" SelectedItem="{Binding Path=MessageFontSize}" Width="80" HorizontalAlignment="Left"/>

                        <TextBlock Text="{localization:LocBinding MessageHighlightByReceiverColor}" ToolTip="{localization:LocBinding MessageHighlightByReceiverColorTooltip}" VerticalAlignment="Center"  Grid.Row="18"/>
                        <ToggleButton Grid.Row="18" Grid.Column="1" IsChecked="{Binding Path=ShowMessageHighlightByReceiverColor}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,0"/>

                        <TextBlock Text="{localization:LocBinding SeparateIpLoggersByPort}" ToolTip="{localization:LocBinding SeparateIpLoggersByPortTooltip}" VerticalAlignment="Center"  Grid.Row="19"/>
                        <ToggleButton Grid.Row="19" Grid.Column="1" IsChecked="{Binding Path=IsSeparateIpLoggersByPort}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                    </Grid>
                </GroupBox>
            </TabItem>
            <TabItem Header="{localization:LocBinding Receivers}" Height="25" Width="90">
                <GroupBox FontSize="16" Style="{DynamicResource MaterialDesignGroupBox}" materialDesign:ShadowAssist.ShadowDepth="Depth2">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{localization:LocBinding ListOfReceivers}" FontSize="16" Foreground="{Binding DataContext.FontColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.RowSpan="2"/>
                        <Button Foreground="{Binding Path=FontColor}" Width="100" HorizontalAlignment="Left" Content="{localization:LocBinding Add}" Margin="5" Command="{Binding Path=AddReceiverCommand}"/>
                        <Button Foreground="{Binding Path=FontColor}" x:Name="RemoveButton" Width="100" HorizontalAlignment="Right" Content="{localization:LocBinding Remove}" Margin="5" Command="{Binding Path=RemoveReceiverCommand}" 
                                Style="{StaticResource RemoveButtonStyle}"/>

                        <ListBox HorizontalContentAlignment="Stretch" Grid.Row="1" Grid.Column="0" Margin="5" ItemsSource="{Binding Path=Receivers}" SelectedItem="{Binding Path=SelectedReceiver}" x:Name="ReceiversList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="ListItemGrid">
                                        <TextBlock Text="{Binding Path=Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                                        <CheckBox IsChecked="{Binding Path=IsActive, Mode=TwoWay}" ToolTip="{localization:LocBinding IsActive}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsActive}" Value="False">
                                            <Setter Property="ListBoxItem.Opacity" Value="0.5"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Column="1" Grid.RowSpan="2" Margin="5,0,0,0"/>

                        <StackPanel Orientation="Vertical" Grid.RowSpan="2" Grid.Column="1" Margin="10,5,10,5" Visibility="{Binding Path=IsConfigurationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="" FontWeight="Bold"/>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{localization:LocBinding ReceiverName}" VerticalAlignment="Center" FontSize="14"/>
                                <TextBox Grid.Column="1" Text="{Binding Path=SelectedReceiver.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="1" Text="{localization:LocBinding ReceiverTransport}" VerticalAlignment="Center" FontSize="14"/>
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding TransportList}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedReceiver.Transport, Mode=TwoWay}"/>
                                <TextBlock Grid.Row="2" Text="{localization:LocBinding UDPPortNumber}" VerticalAlignment="Center" FontSize="14"/>
                                <TextBox  Grid.Row="2" Grid.Column="1" >
                                    <TextBox.Text>
                                        <Binding Path="SelectedReceiver.Port" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <local:PortNumberValidation ValidatesOnTargetUpdated="True"/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>

                                <TextBlock Grid.Row="3" Text="{localization:LocBinding Color}" VerticalAlignment="Center" Margin="0,0"/>
                                <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1">
                                    <dropDownCustomColorPicker:CustomColorPicker Width="50" Margin="0,20" SelectedColor="{Binding Path=SelectedReceiver.Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Style="{StaticResource SetDefaultButtonStyle}" Command="{Binding Path=SetDefaultColorCommand}" CommandParameter="Receiver"/>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{localization:LocBinding Encoding}" VerticalAlignment="Center" Margin="0,-10,0,10"/>
                                <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding EncodingList}" SelectedItem="{Binding SelectedReceiver.Encoding}" Margin="0,-10,0,10"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </TabItem>
            <TabItem Header="{localization:LocBinding IgnoredList}" Height="25" Width="90">
                <GroupBox Style="{DynamicResource MaterialDesignGroupBox}" FontSize="16" materialDesign:ShadowAssist.ShadowDepth="Depth2">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{localization:LocBinding IgnoredIPAddresses}" FontSize="16" Foreground="{Binding DataContext.FontColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0" Foreground="{Binding Path=FontColor}" Style="{StaticResource AddIgnoreIpButtonStyle}"/>
                        <Button Grid.Row="0" Foreground="{Binding Path=FontColor}" Style="{StaticResource RemoveIgnoreIpButtonStyle}"/>

                        <TextBox Grid.Row="1" Style="{StaticResource IPTextBoxStyle}" materialDesign:HintAssist.Hint="{localization:LocBinding IPAddress}" x:Name="IPAddress">
                            <TextBox.Text>
                                <Binding NotifyOnValidationError="True" Path="TypedIP" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <validations:IPValidation ValidatesOnTargetUpdated="True"/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                        <Border Grid.RowSpan="3"/>

                        <ListBox Grid.Row="2" Grid.Column="0" Margin="5,20,5,5" ItemsSource="{Binding Path=IgnoredIpAdresses}" SelectedItem="{Binding Path=SelectedIP}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid x:Name="ListItemGrid">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="115"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Path=IP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                                        <CheckBox VerticalAlignment="Bottom" Grid.Column="1" IsChecked="{Binding Path=IsActive, Mode=TwoWay}" ToolTip="{localization:LocBinding IsActive}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsActive}" Value="False">
                                            <Setter Property="ListBoxItem.Opacity" Value="0.5"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </GroupBox>
            </TabItem>
            <TabItem Header="{localization:LocBinding HighlightRules}" Height="25" Width="110">
                <GroupBox FontSize="16" Style="{DynamicResource MaterialDesignGroupBox}" materialDesign:ShadowAssist.ShadowDepth="Depth2">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{localization:LocBinding HighlightRulesHeader}" FontSize="16" Foreground="{Binding DataContext.FontColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" MinWidth="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="8,0,8,8" FontSize="12"
                                   Text="{localization:LocBinding HighlightRulePriorityHint}"/>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="8,0,8,8">
                            <Button Foreground="{Binding Path=FontColor}" MinWidth="96" Padding="16,0" Height="32"
                                    Content="{localization:LocBinding Add}" Margin="0,0,8,0"
                                    Command="{Binding Path=AddHighlightRuleCommand}"/>
                            <Button Foreground="{Binding Path=FontColor}" MinWidth="96" Padding="16,0" Height="32"
                                    Content="{localization:LocBinding Remove}" Margin="0,0,8,0"
                                    Command="{Binding Path=RemoveHighlightRuleCommand}"/>
                            <Button Foreground="{Binding Path=FontColor}" MinWidth="40" Padding="0" Height="32" Width="40"
                                    Content="↑" Margin="0,0,8,0"
                                    Command="{Binding Path=MoveHighlightRuleUpCommand}"
                                    ToolTip="{localization:LocBinding HighlightRuleMoveUp}"/>
                            <Button Foreground="{Binding Path=FontColor}" MinWidth="40" Padding="0" Height="32" Width="40"
                                    Content="↓"
                                    Command="{Binding Path=MoveHighlightRuleDownCommand}"
                                    ToolTip="{localization:LocBinding HighlightRuleMoveDown}"/>
                        </StackPanel>

                        <ListBox Grid.Row="2" Grid.Column="0" Margin="8,0,8,8"
                                 HorizontalContentAlignment="Stretch"
                                 ItemsSource="{Binding Path=HighlightRules}"
                                 SelectedItem="{Binding Path=SelectedHighlightRule}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Path=Name}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Path=Enabled, Mode=TwoWay}"
                                                  ToolTip="{localization:LocBinding HighlightRuleEnabled}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Path=Enabled}" Value="False">
                                            <Setter Property="ListBoxItem.Opacity" Value="0.5"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ScrollViewer Grid.Row="2" Grid.Column="1" Margin="8,0,8,8" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding Path=IsHighlightEditorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{localization:LocBinding HighlightRuleName}" VerticalAlignment="Center" FontSize="14" Margin="0,0,12,8"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                         Text="{Binding Path=SelectedHighlightRule.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Text="{localization:LocBinding HighlightRuleEnabled}" VerticalAlignment="Center" FontSize="14" Margin="0,0,12,8"/>
                                <ToggleButton Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Margin="0,0,0,8"
                                              IsChecked="{Binding Path=SelectedHighlightRule.Enabled}"/>

                                <TextBlock Grid.Row="2" Text="{localization:LocBinding HighlightRuleLevel}" VerticalAlignment="Center" FontSize="14" Margin="0,0,12,8"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                                          ItemsSource="{Binding Path=HighlightLevelChoices}"
                                          SelectedValue="{Binding Path=SelectedHighlightRule.Level}"
                                          SelectedValuePath="Key" DisplayMemberPath="Value"/>

                                <TextBlock Grid.Row="3" Text="{localization:LocBinding HighlightRuleLogger}" VerticalAlignment="Center" FontSize="14" Margin="0,0,12,8"/>
                                <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Path=SelectedHighlightRule.LoggerPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                              Content="{localization:LocBinding HighlightRuleRegex}"
                                              IsChecked="{Binding Path=SelectedHighlightRule.LoggerIsRegex}"
                                              ToolTip="{localization:LocBinding HighlightRuleLoggerIsRegex}"/>
                                </Grid>

                                <TextBlock Grid.Row="4" Text="{localization:LocBinding HighlightRuleMessage}" VerticalAlignment="Center" FontSize="14" Margin="0,0,12,8"/>
                                <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Path=SelectedHighlightRule.MessagePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                              Content="{localization:LocBinding HighlightRuleRegex}"
                                              IsChecked="{Binding Path=SelectedHighlightRule.MessageIsRegex}"
                                              ToolTip="{localization:LocBinding HighlightRuleMessageIsRegex}"/>
                                </Grid>

                                <TextBlock Grid.Row="5" Text="{localization:LocBinding HighlightRuleColor}" VerticalAlignment="Center" FontSize="14" Margin="0,0,12,8"/>
                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <dropDownCustomColorPicker:CustomColorPicker Width="50" VerticalAlignment="Center"
                                        SelectedColor="{Binding Path=SelectedHighlightRule.Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Border Width="48" Height="22" Margin="10,0,0,0" VerticalAlignment="Center"
                                            BorderBrush="Gray" BorderThickness="1"
                                            Background="{Binding Path=SelectedHighlightRule.Color}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="6" Text="{localization:LocBinding HighlightRuleOpacity}" VerticalAlignment="Center" FontSize="14" Margin="0,0,12,0"/>
                                <Grid Grid.Row="6" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="5" Maximum="100" SmallChange="1" LargeChange="10"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                            ToolTip="{localization:LocBinding HighlightRuleOpacityToolTip}"
                                            Value="{Binding Path=SelectedHighlightRule.OpacityPercent, Mode=TwoWay}"/>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               Text="{Binding Path=SelectedHighlightRule.OpacityPercent, StringFormat={}{0}%}"/>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </GroupBox>
            </TabItem>
            <TabItem Header="{localization:LocBinding About}" Width="90" Height="25">
                <GroupBox Style="{DynamicResource MaterialDesignGroupBox}" FontSize="16" materialDesign:ShadowAssist.ShadowDepth="Depth2">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{localization:LocBinding About}" FontSize="16" Foreground="{Binding DataContext.FontColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>

                    <StackPanel Orientation="Vertical">
                        <TextBlock HorizontalAlignment="Center" Text="Log Viewer"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{localization:LocBinding Version}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Path=Version}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="{localization:LocBinding Author}" FontWeight="Bold"/>
                            <TextBlock VerticalAlignment="Center" Text="{localization:LocBinding SinevViktor}"/>
                            <materialDesign:Chip
                                ToolTip="https://github.com/Styort"
                                Margin="10,0,10,0"
                                IconBackground="{DynamicResource PrimaryHueDarkBrush}"
                                IconForeground="{DynamicResource PrimaryHueDarkForegroundBrush}">
                                <Hyperlink NavigateUri="https://github.com/Styort" Click="Hyperlink_OnClick">
                                    <TextBlock Text="GitHub"/>
                                </Hyperlink>
                                <materialDesign:Chip.Icon>
                                    <materialDesign:PackIcon Kind="Github" />
                                </materialDesign:Chip.Icon>
                            </materialDesign:Chip>

                            <materialDesign:Chip
                                ToolTip="https://stackoverflow.com/users/6551141/%D0%92%D0%B8%D1%82%D1%91%D0%BA-%D0%A1%D0%B8%D0%BD%D1%91%D0%B2"
                                IconBackground="{DynamicResource PrimaryHueDarkBrush}"
                                IconForeground="{DynamicResource PrimaryHueDarkForegroundBrush}"
>
                                <Hyperlink NavigateUri="https://stackoverflow.com/users/6551141/%D0%92%D0%B8%D1%82%D1%91%D0%BA-%D0%A1%D0%B8%D0%BD%D1%91%D0%B2" Click="Hyperlink_OnClick">
                                    <TextBlock Text="Stack Overflow"/>
                                </Hyperlink>
                                <materialDesign:Chip.Icon>
                                    <materialDesign:PackIcon Kind="StackOverflow" />
                                </materialDesign:Chip.Icon>
                            </materialDesign:Chip>
                        </StackPanel>
                        <TextBlock Text="{localization:LocBinding LogViewerFeatures}"/>
                        <Border BorderThickness="1" Height="100" Margin="0,5" Padding="5">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{localization:LocBinding FeaturesStr1}"/>
                                <TextBlock Text="{localization:LocBinding FeaturesStr2}"/>
                                <TextBlock Text="{localization:LocBinding FeaturesStr3}"/>
                                <TextBlock Text="{localization:LocBinding FeaturesStr4}"/>
                            </StackPanel>
                        </Border>
                        <Button Content="{localization:LocBinding ShowReleaseNotes}" Command="{Binding Path=ShowReleaseNotesCommand}" Height="35" Width="200"/>
                    </StackPanel>
                </GroupBox>
            </TabItem>
        </TabControl>
        <Button Grid.Row="1" Grid.Column="0" Foreground="{Binding Path=FontColor}" Width="200" HorizontalAlignment="Left" Margin="5,0,120,0" Content="{localization:LocBinding CheckForUpdates}" Command="{Binding Path=CheckUpdatesCommand}" />
        <Button Grid.Row="1" Grid.ColumnSpan="2" Foreground="{Binding Path=FontColor}" Width="105" HorizontalAlignment="Right" Margin="0,0,120,0" Content="{localization:LocBinding Save}" Command="{Binding Path=SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
        <Button Grid.Row="1" Grid.ColumnSpan="2" Foreground="{Binding Path=FontColor}" Width="105" HorizontalAlignment="Right" Margin="120,0,5,0" Content="{localization:LocBinding Cancel}" Command="{Binding Path=CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Grid>
</Window>
